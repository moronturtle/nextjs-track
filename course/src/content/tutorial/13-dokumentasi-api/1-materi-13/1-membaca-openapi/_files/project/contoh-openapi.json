{
  "openapi": "3.0.3",
  "info": {
    "title": "API Latihan Todo",
    "version": "1.0.0",
    "description": "API latihan untuk materi pertemuan 07-13. Setelah login, owner diambil dari token sehingga ?owner= tidak perlu dikirim."
  },
  "paths": {
    "/api/todos": {
      "get": {
        "summary": "Daftar todo",
        "parameters": [
          { "name": "q", "in": "query", "description": "Cari teks yang mengandung kata ini", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["semua", "belum", "selesai"], "default": "semua" } },
          { "name": "page", "in": "query", "schema": { "type": "number", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "number", "default": 10 } }
        ],
        "responses": {
          "200": { "description": "Daftar todo dalam satu halaman" },
          "400": { "description": "Parameter tidak valid" }
        }
      },
      "post": {
        "summary": "Tambah todo baru",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["teks"],
                "properties": { "teks": { "type": "string", "example": "Belajar OpenAPI" } }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Todo berhasil dibuat" },
          "400": { "description": "teks wajib diisi dan minimal 3 karakter" }
        }
      }
    },
    "/api/todos/{id}": {
      "get": {
        "summary": "Detail satu todo",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "number" } }
        ],
        "responses": {
          "200": { "description": "Satu objek todo" },
          "404": { "description": "Todo tidak ditemukan" }
        }
      },
      "patch": {
        "summary": "Ubah sebagian isi todo",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "number" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "teks": { "type": "string" },
                  "selesai": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Todo setelah diubah" },
          "404": { "description": "Todo tidak ditemukan" }
        }
      },
      "delete": {
        "summary": "Hapus todo",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "number" } }
        ],
        "responses": {
          "204": { "description": "Berhasil dihapus, tanpa body" },
          "404": { "description": "Todo tidak ditemukan" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Login dan dapatkan token JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nama"],
                "properties": { "nama": { "type": "string", "example": "budi" } }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Token dan nama" },
          "400": { "description": "nama wajib diisi dan minimal 3 karakter" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token dari POST /api/auth/login. Kirim sebagai Authorization: Bearer <token>."
      }
    },
    "schemas": {
      "Todo": {
        "type": "object",
        "properties": {
          "id": { "type": "number", "example": 1 },
          "teks": { "type": "string", "example": "Belajar dasar fetch" },
          "selesai": { "type": "boolean", "example": false }
        }
      },
      "DaftarTodos": {
        "type": "object",
        "properties": {
          "todos": { "type": "array", "items": { "$ref": "#/components/schemas/Todo" } },
          "total": { "type": "number", "example": 12 },
          "page": { "type": "number", "example": 1 },
          "limit": { "type": "number", "example": 10 },
          "totalHalaman": { "type": "number", "example": 2 }
        }
      }
    }
  }
}
