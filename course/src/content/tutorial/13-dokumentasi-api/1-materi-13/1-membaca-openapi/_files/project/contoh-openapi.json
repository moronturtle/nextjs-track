{
  "openapi": "3.0.3",
  "info": {
    "title": "API Latihan Todo",
    "version": "1.0.0",
    "description": "Contoh dokumentasi API Todo. Sebelum memakai login, owner dapat dikirim lewat query. Setelah login, server membaca owner dari token."
  },
  "paths": {
    "/api/todos": {
      "get": {
        "summary": "Daftar todo",
        "parameters": [
          {
            "name": "owner",
            "in": "query",
            "description": "Nama pemilik daftar sebelum memakai token.",
            "schema": { "type": "string", "example": "budi" }
          },
          {
            "name": "q",
            "in": "query",
            "description": "Cari teks yang mengandung kata ini",
            "schema": { "type": "string" }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["semua", "belum", "selesai"],
              "default": "semua"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "number", "default": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "number", "default": 10 }
          }
        ],
        "responses": {
          "200": { "description": "Daftar todo dalam satu halaman" },
          "400": { "description": "Parameter tidak valid" }
        }
      },
      "post": {
        "summary": "Tambah todo baru",
        "parameters": [
          {
            "name": "owner",
            "in": "query",
            "description": "Nama pemilik daftar sebelum memakai token.",
            "schema": { "type": "string", "example": "budi" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["teks"],
                "properties": {
                  "teks": { "type": "string", "example": "Belajar OpenAPI" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Todo berhasil dibuat" },
          "400": { "description": "teks wajib diisi dan minimal 3 karakter" }
        }
      }
    },
    "/api/todos/{id}": {
      "get": {
        "summary": "Detail satu todo",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "number" }
          }
        ],
        "responses": {
          "200": { "description": "Satu objek todo" },
          "404": { "description": "Todo tidak ditemukan" }
        }
      },
      "patch": {
        "summary": "Ubah sebagian isi todo",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "number" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "teks": { "type": "string" },
                  "selesai": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Todo setelah diubah" },
          "404": { "description": "Todo tidak ditemukan" }
        }
      },
      "delete": {
        "summary": "Hapus todo",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "number" }
          }
        ],
        "responses": {
          "204": { "description": "Berhasil dihapus, tanpa body" },
          "404": { "description": "Todo tidak ditemukan" }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "summary": "Daftar akun dan dapatkan token JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nama", "password"],
                "properties": {
                  "nama": { "type": "string", "example": "budi" },
                  "password": { "type": "string", "example": "rahasia123" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Akun dibuat dan token dikirim" },
          "400": { "description": "Nama atau password tidak memenuhi aturan" },
          "409": { "description": "Nama sudah digunakan" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Login dan dapatkan token JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nama", "password"],
                "properties": {
                  "nama": { "type": "string", "example": "budi" },
                  "password": { "type": "string", "example": "rahasia123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Token dan nama" },
          "400": { "description": "Body tidak valid" },
          "401": { "description": "Nama atau password salah" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token dari POST /api/auth/register atau POST /api/auth/login. Kirim sebagai Authorization: Bearer <token>."
      }
    },
    "schemas": {
      "Todo": {
        "type": "object",
        "properties": {
          "id": { "type": "number", "example": 1 },
          "teks": { "type": "string", "example": "Belajar dasar fetch" },
          "selesai": { "type": "boolean", "example": false }
        }
      },
      "DaftarTodos": {
        "type": "object",
        "properties": {
          "todos": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Todo" }
          },
          "total": { "type": "number", "example": 12 },
          "page": { "type": "number", "example": 1 },
          "limit": { "type": "number", "example": 10 },
          "totalHalaman": { "type": "number", "example": 2 }
        }
      }
    }
  }
}
