# Salin file ini menjadi .env.local untuk menjalankan api secara lokal.
# Tanpa dua variabel Upstash di bawah, api memakai file .data/todos.json
# sebagai penyimpanan lokal — cukup untuk mencoba semua endpoint.

# Upstash Redis (wajib di Vercel; opsional di lokal)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Kunci rahasia untuk menandatangani token JWT.
# Di lokal boleh dibiarkan kosong (ada nilai bawaan untuk pengembangan).
JWT_SECRET=
